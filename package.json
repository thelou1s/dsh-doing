{
  "name": "dsh-doing",
  "version": "0.1.0",
  "description": "Plays a looping beep while the agent works and a two-beep alert while it waits for your confirmation.",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "notification",
    "audio",
    "beep",
    "alert"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelou1s/dsh-doing.git"
  },
  "homepage": "https://github.com/thelou1s/dsh-doing#readme",
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "assets/icon-180.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "icon": "icon.svg"
}
